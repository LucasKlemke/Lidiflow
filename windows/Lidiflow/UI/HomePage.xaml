<UserControl x:Class="Lidiflow.UI.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Início" Style="{StaticResource PageTitle}" />
        <TextBlock Style="{StaticResource Subtle}"
                   Text="Fale em qualquer app: o Lidiflow escreve, limpa e cola o texto onde o cursor estiver." />

        <Border Style="{StaticResource Card}" Margin="0,20,0,8">
            <StackPanel>
                <TextBlock FontSize="18" FontWeight="SemiBold">
                    <Run Text="Segure " /><Run Text="{Binding DictateLabel, Mode=OneWay}" FontStyle="Italic" /><Run Text=" e fale" />
                </TextBlock>
                <TextBlock Text="{Binding Status}" Style="{StaticResource Subtle}" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <UniformGrid Columns="3">
            <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="{Binding TotalWords}" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="palavras ditadas" Style="{StaticResource Subtle}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="4,0,4,0">
                <StackPanel>
                    <TextBlock Text="{Binding StreakDays}" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="dias seguidos" Style="{StaticResource Subtle}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding WordsPerMinute}" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="palavras por minuto" Style="{StaticResource Subtle}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <DockPanel Margin="0,28,0,10">
            <Button DockPanel.Dock="Right" Content="Limpar histórico" Click="Clear_Click" />
            <TextBox x:Name="Search" DockPanel.Dock="Right" Width="220" Margin="0,0,8,0" TextChanged="Search_TextChanged"
                     ToolTip="Buscar no histórico" />
            <TextBlock Text="Histórico" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>

        <TextBlock x:Name="EmptyText" Style="{StaticResource Subtle}" Margin="0,0,0,8" />
        <ItemsControl x:Name="HistoryList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button Content="Copiar" Click="Copy_Click" Margin="8,0,0,0" />
                                <Button Content="Apagar" Click="Delete_Click" Margin="8,0,0,0" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{Binding DateLabel}" Style="{StaticResource Subtle}" FontSize="12" />
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
