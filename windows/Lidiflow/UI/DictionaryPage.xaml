<UserControl x:Class="Lidiflow.UI.DictionaryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Dicionário e snippets" Style="{StaticResource PageTitle}" />
        <TextBlock Style="{StaticResource Subtle}"
                   Text="Ensine nomes e siglas para o Lidiflow escrever do seu jeito." />

        <!-- Words -->
        <TextBlock Text="Dicionário" Style="{StaticResource SectionTitle}" />
        <TextBlock Style="{StaticResource Subtle}" Margin="0,0,0,8"
                   Text="Palavras, nomes e siglas que a transcrição deve reconhecer (ex.: Lidiflow, Kubernetes, CNPJ)." />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox x:Name="WordBox" Width="300" KeyDown="WordBox_KeyDown" />
            <Button Content="Adicionar" Margin="8,0,0,0" Click="AddWord_Click" />
        </StackPanel>
        <ItemsControl x:Name="WordList">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Chip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                            <Button Content="✕" Margin="8,0,0,0" Padding="6,0" FontSize="10" Click="RemoveWord_Click" ToolTip="Remover" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Replacements -->
        <TextBlock Text="Correções" Style="{StaticResource SectionTitle}" />
        <TextBlock Style="{StaticResource Subtle}" Margin="0,0,0,8"
                   Text="Troca uma palavra ou expressão por outra depois da transcrição (ex.: “lidi flow” → “Lidiflow”)." />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox x:Name="FromBox" Width="200" ToolTip="Quando eu disser" />
            <TextBlock Text="→" Margin="10,0" VerticalAlignment="Center" />
            <TextBox x:Name="ToBox" Width="200" ToolTip="Escreva" />
            <Button Content="Adicionar" Margin="8,0,0,0" Click="AddReplacement_Click" />
        </StackPanel>
        <ItemsControl x:Name="ReplacementList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="14,8">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Remover" Click="RemoveReplacement_Click" />
                            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                                <Run Text="{Binding From, Mode=OneWay}" /><Run Text="  →  " /><Run Text="{Binding To, Mode=OneWay}" FontWeight="SemiBold" />
                            </TextBlock>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Snippets -->
        <TextBlock Text="Snippets" Style="{StaticResource SectionTitle}" />
        <TextBlock Style="{StaticResource Subtle}" Margin="0,0,0,8"
                   Text="Diga a frase e o Lidiflow insere o texto completo (ex.: “meu email” → seu endereço de email)." />
        <DockPanel Margin="0,0,0,10">
            <TextBox x:Name="TriggerBox" Width="200" VerticalAlignment="Top" ToolTip="Quando eu disser" />
            <TextBlock Text="→" Margin="10,6,10,0" VerticalAlignment="Top" />
            <Button DockPanel.Dock="Right" Content="Adicionar" Margin="8,0,0,0" VerticalAlignment="Top" Click="AddSnippet_Click" />
            <TextBox x:Name="ExpansionBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" ToolTip="Insira este texto" />
        </DockPanel>
        <ItemsControl x:Name="SnippetList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="14,8">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Remover" VerticalAlignment="Top" Click="RemoveSnippet_Click" />
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold">
                                    <Run Text="“" /><Run Text="{Binding Trigger, Mode=OneWay}" /><Run Text="”" />
                                </TextBlock>
                                <TextBlock Text="{Binding Expansion}" Style="{StaticResource Subtle}" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
