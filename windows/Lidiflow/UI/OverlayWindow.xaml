<Window x:Class="Lidiflow.UI.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lidiflow"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Focusable="False">
    <!-- The dictation bar. The content for each state is built in code (OverlayWindow.xaml.cs); the window is sized
         and placed in physical pixels on the monitor under the mouse, and the border fills it. 10 pt corners, as on
         the Mac. -->
    <Border x:Name="Root" CornerRadius="10" BorderThickness="1" SnapsToDevicePixels="True"
            TextElement.FontFamily="{StaticResource BodyFont}" TextElement.Foreground="White" />
</Window>
