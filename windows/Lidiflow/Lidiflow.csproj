<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Lidiflow</AssemblyName>
    <RootNamespace>Lidiflow</RootNamespace>
    <Version>0.1.0</Version>
    <!-- WPF's Fluent theme (ThemeMode) is still flagged as experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <!-- build.ps1 generates the .ico from Resources/AppIcon-1024.png. -->
    <ApplicationIcon Condition="Exists('Assets\AppIcon.ico')">Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\Resources\AppIcon-1024.png" Link="Assets\AppIcon.png" />
  </ItemGroup>

</Project>
